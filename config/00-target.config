#
# 目标平台与机型
# R2S 与 R5S 同属 rockchip/armv8（aarch64_generic），一次编译同时产出两个固件
# R4S 不在此列：它在 ImmortalWrt 25.12 下无法启动，改由 build-r4s-lede.yml 单独构建
#
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y

CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5s=y

#
# 镜像格式
# ext4      —— 可用 resize2fs 扩容，适合装 Docker / 大插件
# squashfs  —— 带 overlay，支持一键恢复出厂设置
# 两种都出，刷机时自己挑
#
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_IMAGES_GZIP=y

#
# 构建选项
# CCACHE 依赖 DEVEL，缓存目录默认 ./.ccache（workflow 里会缓存它）
#
CONFIG_DEVEL=y
CONFIG_CCACHE=y

#
# 简体中文：自动拉取所有已装 LuCI 应用对应的 zh-cn 语言包
#
CONFIG_LUCI_LANG_zh_Hans=y
