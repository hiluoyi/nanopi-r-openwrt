#
# 插件清单 —— 这是你日常唯一需要改的文件
# 全部来自 ImmortalWrt 25.12 自带 feed，无需任何第三方源
# 加插件：加一行 CONFIG_PACKAGE_<名字>=y，然后 make defconfig 会自动补齐依赖
#

# ---------- 主题 ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- 网络组件 ----------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
CONFIG_PACKAGE_luci-app-openclash=y

# ---------- DNS ----------
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-adguardhome=y

# ---------- 网络工具 ----------
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-watchcat=y

# ---------- 系统 / 监控 ----------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_collectd-mod-ping=y

# ---------- 存储 / NAS ----------
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-samba4=y

# ---------- R2S 专用：OLED 小屏 ----------
CONFIG_PACKAGE_luci-app-oled=y

# ---------- USB 网卡 / 无线网卡驱动 ----------
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-mt76x2u=y
CONFIG_PACKAGE_kmod-rtw88-8821cu=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# ---------- 常用命令行工具 ----------
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y

# ---------- 可选：Docker ----------
# R2S 只有 512MB 内存，跑 Docker 意义不大；R4S(4GB) / R5S(4~8GB) 可以打开
# 注意：三机型共用一份包列表，打开后 R2S 固件也会带上（约 +120MB）
# CONFIG_PACKAGE_luci-app-dockerman=y
